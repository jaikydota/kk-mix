# 复制为 build_secrets.env（已被 .gitignore 忽略）后填写，setup_cython.py 编译时读取。
# 也可以直接用同名环境变量，环境变量优先级更高。

# 是否启用授权校验：1/true/yes/on 为启用，留空或 0 为关闭（默认关闭）
# 开关在编译时烧录进 .pyd，运行期无法篡改；正式发布务必设为 1
KK_LICENSE_ENABLED=0

# 授权码加密种子：任意随机字符串，改了之后旧授权码全部失效
# 启用授权校验时务必改掉，否则任何人都能用公开的默认种子伪造授权码
KK_LICENSE_SEED=change-me-to-a-long-random-string
